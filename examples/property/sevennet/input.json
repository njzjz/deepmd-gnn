{
  "model": {
    "type": "standard",
    "type_map": [
      "H",
      "O"
    ],
    "data_stat_nbatch": 1,
    "descriptor": {
      "type": "sevennet",
      "model_path": "./tiny_sevennet.pth",
      "sel": 16,
      "trainable": true
    },
    "fitting_net": {
      "type": "property",
      "property_name": "band_gap",
      "task_dim": 1,
      "neuron": [
        32,
        32
      ],
      "precision": "float32",
      "seed": 1
    }
  },
  "learning_rate": {
    "type": "exp",
    "decay_steps": 10,
    "start_lr": 0.001,
    "stop_lr": 0.0001
  },
  "loss": {
    "type": "property",
    "loss_func": "mse"
  },
  "training": {
    "training_data": {
      "systems": [
        "./data"
      ],
      "batch_size": 2
    },
    "numb_steps": 20,
    "seed": 1,
    "disp_freq": 1,
    "save_freq": 10,
    "save_ckpt": "model.ckpt"
  }
}
